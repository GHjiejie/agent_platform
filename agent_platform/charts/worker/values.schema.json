{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Platform worker values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 54
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
            "maxLength": 253
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^(sqlite:/{3,4}[^\\s]+)?$"
        }
      },
      "required": [
        "existingSecret",
        "urlKey",
        "url"
      ]
    },
    "sqliteStorage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "enabled",
        "existingClaim",
        "mountPath"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      },
      "required": [
        "type"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "runtimeSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "encryptionKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "existingSecret",
        "encryptionKey"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "local",
            "saas"
          ]
        },
        "redisUrl": {
          "type": "string",
          "pattern": "^redis(s)?://"
        },
        "litellmUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "runTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "modelTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "maxRunCost": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      },
      "required": [
        "mode",
        "redisUrl",
        "litellmUrl",
        "concurrency",
        "runTimeout",
        "modelTimeout",
        "maxRunCost"
      ]
    },
    "legacyGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "existingSecret",
        "key"
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ]
        }
      },
      "required": [
        "startup",
        "readiness",
        "liveness"
      ]
    }
  },
  "required": [
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "podAnnotations",
    "nodeSelector",
    "affinity",
    "tolerations",
    "podSecurityContext",
    "securityContext",
    "resources",
    "database",
    "sqliteStorage",
    "replicaCount",
    "strategy",
    "terminationGracePeriodSeconds",
    "runtimeSecret",
    "config",
    "legacyGateway",
    "probes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "mode": {
                "const": "saas"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sqliteStorage": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "database": {
            "properties": {
              "url": {
                "const": ""
              }
            }
          },
          "legacyGateway": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sqliteStorage": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "replicaCount": {
            "maximum": 1
          },
          "strategy": {
            "properties": {
              "type": {
                "const": "Recreate"
              }
            }
          },
          "database": {
            "properties": {
              "url": {
                "minLength": 1
              }
            }
          },
          "nodeSelector": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "database": {
            "properties": {
              "url": {
                "minLength": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sqliteStorage": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
