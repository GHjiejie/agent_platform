{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "persistence": {
      "type": "object",
      "required": [
        "size",
        "storageClass",
        "accessModes"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+([.][0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|K|M|G|T|P|E)?$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": [
        "existingSecret",
        "passwordKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fullnameOverride",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "terminationGracePeriodSeconds",
    "persistence",
    "service",
    "auth"
  ],
  "additionalProperties": false
}
