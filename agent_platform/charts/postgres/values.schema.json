{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "persistence": {
      "type": "object",
      "required": [
        "size",
        "storageClass",
        "accessModes"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+([.][0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|K|M|G|T|P|E)?$"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "required": [
        "existingSecret",
        "adminPasswordKey",
        "litellmPasswordKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "adminPasswordKey": {
          "type": "string",
          "minLength": 1
        },
        "litellmPasswordKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "required": [
        "user",
        "database"
      ],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        }
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "litellm"
      ],
      "properties": {
        "litellm": {
          "type": "object",
          "required": [
            "enabled",
            "user",
            "database"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "user": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fullnameOverride",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "terminationGracePeriodSeconds",
    "persistence",
    "service",
    "credentials",
    "admin",
    "bootstrap"
  ],
  "additionalProperties": false
}
